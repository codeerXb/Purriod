page {
  min-height: 100vh;
  background: #FAF0F2;
  color: #3D3D3D;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background: linear-gradient(180deg, #FAF0F2 0%, #FFF8F9 42%, #FFFFFF 100%);
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3D3D3D;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #9E9E9E;
  font-size: 26rpx;
}

.card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(212, 118, 138, 0.12);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D3D3D;
}

.muted {
  color: #9E9E9E;
}

.primary-button {
  height: 92rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #E08A9B 0%, #D4768A 100%);
  box-shadow: 0 16rpx 32rpx rgba(212, 118, 138, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
}

.secondary-button {
  height: 84rpx;
  border-radius: 999rpx;
  color: #D4768A;
  font-size: 28rpx;
  font-weight: 600;
  background: #FFF1F4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #8B7D82;
  background: #F8ECEF;
  font-size: 26rpx;
}

.chip.active {
  color: #FFFFFF;
  background: #D4768A;
}
