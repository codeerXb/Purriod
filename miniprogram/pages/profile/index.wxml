<view class="page profile-page">
  <view class="profile-card card">
    <image class="profile-avatar" src="/images/avatar.png" mode="aspectFill" />
    <view>
      <view class="page-title">我的</view>
      <view class="page-subtitle">让记录保持简单、私密和安心</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">经期设置</view>
    <view class="menu-row" bindtap="goSettings">
      <view>
        <view class="menu-title">周期与经期长度</view>
        <view class="menu-desc">周期 {{cycleLength}} 天 · 经期 {{periodLength}} 天</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">小程序设置</view>
    <view class="menu-row" bindtap="showPrivacy">
      <view>
        <view class="menu-title">隐私政策</view>
        <view class="menu-desc">查看数据收集与使用说明</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="clearData">
      <view>
        <view class="menu-title danger">清除我的数据</view>
        <view class="menu-desc">删除本地与云端经期记录</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="showAbout">
      <view>
        <view class="menu-title">关于 Purriod</view>
        <view class="menu-desc">经期记录、预测和分析</view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
