.analysis-page {
  padding-bottom: 80rpx;
}

.analysis-hero,
.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-chart {
  width: 104rpx;
  height: 78rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 9rpx;
  padding: 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
}

.hero-bar {
  width: 15rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #D4768A, #F0B6C1);
}

.hero-bar.short { height: 22rpx; }
.hero-bar.middle { height: 37rpx; }
.hero-bar.tall { height: 53rpx; }

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 30rpx;
}

.summary-card {
  padding: 28rpx 10rpx;
  border: 1rpx solid rgba(240, 212, 218, 0.78);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 32rpx rgba(139, 125, 130, 0.08);
  text-align: center;
}

.summary-value {
  color: #D4768A;
  font-size: 42rpx;
  font-weight: 800;
}

.summary-value text {
  margin-left: 3rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.summary-label {
  margin-top: 9rpx;
  color: #8B7D82;
  font-size: 22rpx;
}

.chart-card {
  overflow: hidden;
}

.chart-subtitle {
  margin-top: 8rpx;
  color: #9E9E9E;
  font-size: 23rpx;
}

.chart-accent {
  width: 24rpx;
  height: 58rpx;
  border-radius: 999rpx;
}

.chart-accent.sage { background: #C7D8C0; }
.chart-accent.purple { background: #A890C0; }

.empty-chart {
  min-height: 330rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-orbit {
  width: 92rpx;
  height: 92rpx;
  border: 12rpx solid #F0D4DA;
  border-right-color: #C7D8C0;
  border-radius: 50%;
}

.empty-drops {
  color: #D9B7C0;
  font-size: 64rpx;
  letter-spacing: 8rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #5D5055;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 10rpx;
  color: #9E9E9E;
  font-size: 23rpx;
}

.analysis-note,
.loading-hint {
  margin-top: 26rpx;
  color: #9E9E9E;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
