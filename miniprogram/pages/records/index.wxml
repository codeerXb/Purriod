<view class="page records-page">
  <view class="header-row">
    <view>
      <view class="page-title">记录</view>
      <view class="page-subtitle">月历会把实际记录与预计日期分开显示</view>
    </view>
    <view class="header-orbit"></view>
  </view>

  <view class="card calendar-card">
    <view class="calendar-header">
      <button class="month-button" bindtap="prevMonth">‹</button>
      <view class="section-title">{{monthTitle}}</view>
      <button class="month-button" bindtap="nextMonth">›</button>
    </view>

    <view class="week-row">
      <view wx:for="{{weekDays}}" wx:key="*this" class="week-day">{{item}}</view>
    </view>

    <view class="calendar-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="date"
        class="calendar-day {{item.isCurrentMonth ? '' : 'muted-day'}} {{item.isActualPeriod ? 'actual-period' : ''}} {{item.isPredictedPeriod ? 'predicted-period' : ''}} {{item.isOvulationRange ? 'ovulation-range' : ''}} {{item.isOvulationDay ? 'ovulation-day' : ''}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
        data-date="{{item.date}}"
        bindtap="selectDate"
      >
        <text>{{item.day}}</text>
        <view wx:if="{{item.isOvulationDay}}" class="ovulation-mark"></view>
      </view>
    </view>

    <view class="legend">
      <view class="legend-item"><text class="legend-dot actual-dot"></text>经期</view>
      <view class="legend-item"><text class="legend-dot predicted-dot"></text>预测</view>
      <view class="legend-item"><text class="legend-dot ovulation-dot"></text>排卵期</view>
      <view class="legend-item"><text class="legend-flower">●</text>排卵日</view>
    </view>
  </view>

  <view class="card day-card">
    <view class="day-card-header">
      <view>
        <view class="selected-date">{{selectedDate}}</view>
        <view class="section-title day-status">{{summary.statusText}}</view>
      </view>
      <view class="day-petal">◌</view>
    </view>
    <view class="summary-tags" wx:if="{{summary.tags.length}}">
      <view wx:for="{{summary.tags}}" wx:key="*this" class="summary-tag">{{item}}</view>
    </view>
    <view class="day-detail">{{summary.detailText}}</view>
    <button class="secondary-button edit-button" bindtap="editSelectedDate">
      {{summary.hasRecord ? '编辑这一天' : '记录这一天'}}
    </button>
  </view>

  <view wx:if="{{isLoading}}" class="loading-hint">正在整理周期数据…</view>
</view>
