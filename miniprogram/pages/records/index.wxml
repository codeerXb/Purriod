<view class="page records-page">
  <view class="page-title">记录</view>
  <view class="page-subtitle">把每天的身体感受轻轻记下来</view>

  <view class="card calendar-card">
    <view class="calendar-header">
      <button class="month-button" bindtap="prevMonth">‹</button>
      <view class="section-title">{{monthTitle}}</view>
      <button class="month-button" bindtap="nextMonth">›</button>
    </view>

    <view class="week-row">
      <view wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="week-day">{{item}}</view>
    </view>

    <view class="calendar-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="date"
        class="calendar-day {{item.isCurrentMonth ? '' : 'muted-day'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.status}}"
        data-date="{{item.date}}"
        bindtap="selectDate"
      >
        <text>{{item.day}}</text>
        <view class="day-dot" wx:if="{{item.status}}"></view>
      </view>
    </view>

    <view class="legend">
      <view><text class="legend-dot period-dot"></text>经期</view>
      <view><text class="legend-dot predicted-dot"></text>预测</view>
      <view><text class="legend-dot ovulation-dot"></text>排卵</view>
    </view>
  </view>

  <view class="card form-card">
    <view class="section-title">{{selectedDate}}</view>

    <view class="switch-row">
      <text>月经开始</text>
      <switch color="#D4768A" checked="{{selectedRecord.isPeriodStart}}" bindchange="setPeriodStart" />
    </view>
    <view class="switch-row">
      <text>月经结束</text>
      <switch color="#D4768A" checked="{{selectedRecord.isPeriodEnd}}" bindchange="setPeriodEnd" />
    </view>

    <view class="field-block">
      <view class="field-title">流量</view>
      <view class="chip-row">
        <view wx:for="{{flowOptions}}" wx:key="value" class="chip {{selectedRecord.flow === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseFlow">{{item.label}}</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-title">痛经</view>
      <view class="chip-row">
        <view wx:for="{{painOptions}}" wx:key="value" class="chip {{selectedRecord.pain === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="choosePain">{{item.label}}</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-title">白带</view>
      <view class="chip-row">
        <view wx:for="{{dischargeOptions}}" wx:key="value" class="chip {{selectedRecord.discharge === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseDischarge">{{item.label}}</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-title">心情</view>
      <view class="chip-row">
        <view wx:for="{{moodOptions}}" wx:key="*this" class="chip {{selectedRecord.mood === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseMood">{{item}}</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-title">症状</view>
      <view class="chip-row wrap">
        <view wx:for="{{symptomOptions}}" wx:key="*this" class="chip {{selectedRecord.symptoms.indexOf(item) >= 0 ? 'active' : ''}}" data-value="{{item}}" bindtap="toggleSymptom">{{item}}</view>
      </view>
    </view>

    <textarea class="notes" value="{{selectedRecord.notes}}" placeholder="想补充点什么？可不填" maxlength="120" bindinput="onNotesInput" />
    <button class="primary-button" bindtap="saveRecord">保存记录</button>
  </view>

  <view class="card analysis-card">
    <view class="section-title">周期分析</view>
    <view class="analysis-grid">
      <view>
        <view class="analysis-value">{{analysis.averageCycle}}天</view>
        <view class="analysis-label">平均周期</view>
      </view>
      <view>
        <view class="analysis-value">{{analysis.averagePeriod}}天</view>
        <view class="analysis-label">平均经期</view>
      </view>
      <view>
        <view class="analysis-value">{{analysis.periodCount}}次</view>
        <view class="analysis-label">经期次数</view>
      </view>
    </view>
  </view>
</view>
