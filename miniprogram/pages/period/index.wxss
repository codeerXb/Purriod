.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(212, 118, 138, 0.22);
}

.cycle-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx 32rpx;
}

.forecast-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.forecast-card {
  min-height: 132rpx;
  padding: 24rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(212, 118, 138, 0.1);
}

.forecast-label {
  color: #9E9E9E;
  font-size: 24rpx;
}

.forecast-value {
  margin-top: 14rpx;
  color: #3D3D3D;
  font-size: 27rpx;
  font-weight: 700;
}

.record-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
  color: #6E6066;
}

.empty-record {
  margin: 24rpx 0;
  color: #9E9E9E;
}

.actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}
