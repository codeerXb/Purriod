.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(212, 118, 138, 0.22);
}

.cycle-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 44rpx;
  padding-bottom: 38rpx;
}

.cycle-ring {
  width: 430rpx;
  height: 430rpx;
  border-radius: 50%;
  padding: 32rpx;
  background: conic-gradient(#D4768A 0deg 110deg, #F0C4CD 110deg 230deg, #A890C0 230deg 280deg, #E9D9CF 280deg 360deg);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.65), 0 22rpx 46rpx rgba(212, 118, 138, 0.18);
}

.cycle-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.phase-name {
  color: #D4768A;
  font-size: 42rpx;
  font-weight: 800;
}

.day-text {
  margin-top: 14rpx;
  color: #3D3D3D;
  font-size: 34rpx;
  font-weight: 700;
}

.helper-text {
  margin-top: 30rpx;
  color: #8B7D82;
  font-size: 28rpx;
  text-align: center;
}

.forecast-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.forecast-card {
  min-height: 132rpx;
  padding: 24rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(212, 118, 138, 0.1);
}

.forecast-label {
  color: #9E9E9E;
  font-size: 24rpx;
}

.forecast-value {
  margin-top: 14rpx;
  color: #3D3D3D;
  font-size: 27rpx;
  font-weight: 700;
}

.record-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
  color: #6E6066;
}

.empty-record {
  margin: 24rpx 0;
  color: #9E9E9E;
}

.actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}
