.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(212, 118, 138, 0.22);
}

.cycle-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx 32rpx;
}

.forecast-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.forecast-card {
  min-height: 132rpx;
  padding: 24rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(212, 118, 138, 0.1);
}

.forecast-label {
  color: #9E9E9E;
  font-size: 24rpx;
}

.forecast-value {
  margin-top: 14rpx;
  color: #3D3D3D;
  font-size: 27rpx;
  font-weight: 700;
}

.record-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
  color: #6E6066;
}

.today-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-status {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #A25467;
  background: #FAE8EC;
  font-size: 22rpx;
  font-weight: 700;
}

.record-summary view {
  padding: 16rpx;
  border-radius: 18rpx;
  background: #FFF7F9;
}

.record-summary text {
  display: block;
  margin-bottom: 6rpx;
  color: #A39399;
  font-size: 21rpx;
}

.record-summary .summary-wide {
  grid-column: 1 / -1;
}

.empty-record {
  margin: 24rpx 0;
  color: #9E9E9E;
}

.actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.sync-banner {
  margin-top: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 20rpx;
  color: #7A686E;
  background: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  text-align: center;
}
