<view class="page period-page">
  <view class="hero">
    <view>
      <view class="page-title">Purriod</view>
      <view class="page-subtitle">温柔记录你的周期节奏</view>
    </view>
    <image class="avatar" src="/images/avatar.png" mode="aspectFill" />
  </view>

  <view class="cycle-card card {{phaseKey}}">
    <cycle-ring model="{{ringModel}}" />
  </view>

  <view class="forecast-grid">
    <view class="forecast-card">
      <view class="forecast-label">下次经期</view>
      <view class="forecast-value">{{nextPeriodStart}}</view>
    </view>
    <view class="forecast-card">
      <view class="forecast-label">预计结束</view>
      <view class="forecast-value">{{nextPeriodEnd}}</view>
    </view>
    <view class="forecast-card">
      <view class="forecast-label">排卵日</view>
      <view class="forecast-value">{{ovulationDate}}</view>
    </view>
  </view>

  <view class="card today-card">
    <view class="today-header">
      <view class="section-title">今日记录</view>
      <view wx:if="{{todaySummary}}" class="today-status">{{todaySummary.periodStatus}}</view>
    </view>
    <view class="record-summary" wx:if="{{todaySummary}}">
      <view><text>流量</text>{{todaySummary.flow}}</view>
      <view><text>痛经</text>{{todaySummary.pain}}</view>
      <view><text>白带</text>{{todaySummary.discharge}}</view>
      <view><text>心情</text>{{todaySummary.mood}}</view>
      <view class="summary-wide"><text>症状</text>{{todaySummary.symptoms}}</view>
    </view>
    <view class="empty-record" wx:else>今天还没有记录，轻点一下就好。</view>
    <button class="secondary-button" bindtap="goRecords">去记录详情</button>
  </view>

  <view wx:if="{{syncMessage}}" class="sync-banner">{{syncMessage}}</view>

  <view class="actions">
    <button class="primary-button" bindtap="markPeriodStart">记录月经开始</button>
    <button class="secondary-button" bindtap="markPeriodEnd">记录月经结束</button>
  </view>
</view>
