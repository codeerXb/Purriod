.ring-component {
  width: 100%;
}

.ring-shell {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  margin: 0 auto;
}

.ring-canvas {
  width: 480rpx;
  height: 480rpx;
}

.ring-center {
  position: absolute;
  top: 106rpx;
  right: 106rpx;
  bottom: 106rpx;
  left: 106rpx;
  border: 1rpx solid rgba(240, 212, 218, 0.82);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.93);
  box-shadow: 0 14rpx 42rpx rgba(139, 125, 130, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ring-title {
  color: #D4768A;
  font-size: 34rpx;
  font-weight: 800;
}

.stale .ring-title {
  color: #8B7D82;
}

.ring-value {
  max-width: 210rpx;
  margin-top: 12rpx;
  color: #3D3D3D;
  font-size: 27rpx;
  font-weight: 700;
}

.ring-helper {
  min-height: 76rpx;
  margin-top: 16rpx;
  color: #7E7075;
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.ring-legend {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 16rpx;
  color: #8B7D82;
  font-size: 21rpx;
}

.ring-legend-item {
  display: flex;
  align-items: center;
}

.ring-legend-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 7rpx;
  border-radius: 50%;
}
